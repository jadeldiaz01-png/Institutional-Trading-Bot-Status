{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/ar_tf_dataset.schema.json",
  "title": "AR-TF Point-in-Time Market Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset_id", "version", "source", "retrieved_at", "timezone", "symbols", "fields", "sha256", "point_in_time"],
  "properties": {
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "license": {"type": ["string", "null"]},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "timezone": {"const": "UTC"},
    "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "fields": {"type": "array", "items": {"enum": ["open", "high", "low", "close", "volume", "quote_volume", "trade_count"]}},
    "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "point_in_time": {"const": true},
    "survivorship_bias_control": {"type": "string"},
    "corporate_or_token_events": {"type": "array", "items": {"type": "object"}},
    "known_gaps": {"type": "array", "items": {"type": "object"}}
  }
}
